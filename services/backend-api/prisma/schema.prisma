model User {
  id                                  String                               @id @default(uuid()) @db.Uuid
  fullName                            String
  phoneNumber                         String                               @unique
  email                               String?                              @unique
  passwordHash                        String
  role                                UserRole
  adminRole                           AdminRole?
  accountStatus                       AccountStatus                        @default(PENDING)
  phoneVerified                       Boolean                              @default(false)
  emailVerified                       Boolean                              @default(false)
  profilePhotoUrl                     String?
  onboardingPasswordSetAt             DateTime?
  lastLoginAt                         DateTime?
  deletedAt                           DateTime?
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  customerProfile                     CustomerProfile?
  vendor                              Vendor?
  rider                               Rider?
  addresses                           Address[]
  notifications                       Notification[]
  deviceTokens                        DeviceToken[]
  refreshTokens                       RefreshToken[]
  statusChanges                       OrderStatusHistory[]                 @relation("StatusChangedBy")
  verifiedDocuments                   RiderDocument[]                      @relation("DocumentVerifiedBy")
  vendorApplications                  VendorApplication[]                  @relation("VendorApplicant")
  partnerOnboardingDraft              PartnerOnboardingDraft?
  deliveryCaptainApplications         DeliveryCaptainApplication[]         @relation("DeliveryCaptainApplicant")
  assignedTickets                     SupportTicket[]                      @relation("TicketAssignedAdmin")
  ticketMessages                      SupportTicketMessage[]
  adminAuditLogs                      AdminAuditLog[]
  assignedServiceRequests             ServiceProviderRequest[]             @relation("ServiceProviderRequestAssignedBy")
  reviewedServiceProviderApplications ServiceProviderApplication[]         @relation("ServiceProviderApplicationReviewedBy")
  createdPromoCodes                   PromoCode[]                          @relation("PromoCreatedBy")
  otpVerifications                    OtpVerification[]
  verifiedPayoutAccounts              VendorPayoutAccount[]                @relation("PayoutVerifiedBy")
  taxiDriverApplications              TaxiDriverApplication[]              @relation("TaxiApplicant")
  reviewedTaxiApplications            TaxiDriverApplication[]              @relation("TaxiReviewedBy")
  taxiDriverProfiles                  TaxiDriverProfile[]
  createdWalletLedgerEntries          CustomerWalletLedgerEntry[]          @relation("WalletLedgerEntryCreatedByAdmin")
  createdReferralRewardRules          CustomerReferralRewardRule[]         @relation("ReferralRewardRuleCreatedBy")
  loginActivities                     UserLoginActivity[]
  biometricCredentials                BiometricCredential[]
  vendorTeamMemberships               VendorTeamMember[]                   @relation("VendorTeamUser")
  sentVendorTeamInvitations           VendorTeamMember[]                   @relation("VendorTeamInvitedBy")
  vendorAuditLogs                     VendorAuditLog[]                     @relation("VendorAuditActor")
  verifiedVendorApplicationDocuments  VendorApplicationDocument[]          @relation("VendorApplicationDocumentVerifiedBy")
  reviewedVendorOnboardingDocuments   VendorOnboardingDocument[]           @relation("VendorOnboardingDocumentReviewedBy")
  verifiedDeliveryCaptainDocuments    DeliveryCaptainApplicationDocument[] @relation("DeliveryCaptainApplicationDocumentVerifiedBy")
  captainApplicationDocuments         CaptainApplicationDocument[]         @relation("CaptainApplicationDocumentOwner")
  reviewedCaptainApplicationDocuments CaptainApplicationDocument[]         @relation("CaptainApplicationDocumentReviewedBy")
  accountDeletionRequests             AccountDeletionRequest[]             @relation("AccountDeletionRequestUser")
  reviewedAccountDeletionRequests     AccountDeletionRequest[]             @relation("AccountDeletionRequestReviewedBy")
  vendorActivationAccounts            VendorAccountActivation[]            @relation("VendorActivationUser")
  createdVendorActivationInvitations  VendorAccountActivation[]            @relation("VendorActivationCreatedBy")
  reviewedAdCampaigns                 AdCampaign[]                         @relation("AdCampaignReviewedBy")
  captainWorkState                    CaptainWorkState?

  @@map("users")
}

model AccountDeletionRequest {
  id                  String                            @id @default(uuid()) @db.Uuid
  requestReference    String                            @unique
  userId              String                            @db.Uuid
  accountType         AccountDeletionAccountType
  status              AccountDeletionStatus             @default(REQUESTED)
  reason              String?
  requestedAt         DateTime                          @default(now())
  confirmedAt         DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  blockedReasonCode   AccountDeletionBlockedReasonCode?
  blockerSummary      Json?
  adminNote           String?
  adminReviewedById   String?                           @db.Uuid
  adminReviewedAt     DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  user                User                              @relation("AccountDeletionRequestUser", fields: [userId], references: [id])
  adminReviewedBy     User?                             @relation("AccountDeletionRequestReviewedBy", fields: [adminReviewedById], references: [id])

  @@index([userId, accountType, status])
  @@index([status, requestedAt])
  @@map("account_deletion_requests")
}

model CaptainWorkState {
  id                         String                @id @default(uuid()) @db.Uuid
  userId                     String                @unique @db.Uuid
  desiredDeliveryOnline      Boolean               @default(false)
  desiredRideOnline          Boolean               @default(false)
  activeWorkMode             CaptainWorkMode?
  activeDeliveryAssignmentId String?               @db.Uuid
  activeRideTripId           String?               @db.Uuid
  lockStage                  CaptainWorkLockStage?
  lockedAt                   DateTime?
  lastAvailabilityChangeAt   DateTime?
  lastLocationAt             DateTime?
  version                    Int                   @default(0)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  user                       User                  @relation(fields: [userId], references: [id])

  @@index([activeWorkMode, lockStage])
  @@index([desiredDeliveryOnline, desiredRideOnline])
  @@map("captain_work_states")
}

model UserLoginActivity {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String?              @db.Uuid
  phoneNumberMasked String?
  role              UserRole?
  outcome           LoginActivityOutcome
  reason            String?
  appSurface        AppSurface?
  createdAt         DateTime             @default(now())
  user              User?                @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([outcome, createdAt])
  @@map("user_login_activities")
}

model BiometricCredential {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String                    @db.Uuid
  credentialIdHash String                    @unique
  appSurface       AppSurface
  platform         DevicePlatform?
  displayName      String?
  status           BiometricCredentialStatus @default(REGISTERED)
  lastUsedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  user             User                      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([appSurface, status])
  @@map("biometric_credentials")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model TaxiDriverApplication {
  id                            String                       @id @default(uuid()) @db.Uuid
  applicationReference          String                       @unique
  applicantUserId               String?                      @db.Uuid
  fullName                      String
  phoneNumber                   String
  email                         String?
  city                          String
  state                         String
  residentialStateCode          String?
  residentialCityCode           String?
  operatingAreaIds              String[]                     @default([])
  primaryOperatingAreaId        String?
  address                       String?
  driverLicenceNumber           String?
  driverLicenceDocumentUrl      String?
  driverLicenceExpiry           DateTime?
  vehicleMake                   String?
  vehicleModel                  String?
  vehicleYear                   Int?
  vehicleColour                 String?
  vehicleCustomMake             String?
  vehicleCustomModel            String?
  vehicleCustomColour           String?
  vehiclePlateNumber            String?
  vehicleType                   TaxiVehicleType?
  vehicleOwnership              TaxiVehicleOwnership?
  vehicleParticularsDocumentUrl String?
  insuranceDocumentUrl          String?
  notes                         String?
  status                        TaxiApplicationStatus        @default(SUBMITTED)
  adminNote                     String?
  applicantVisibleNote          String?
  reviewedByAdminId             String?                      @db.Uuid
  reviewedAt                    DateTime?
  trashedAt                     DateTime?
  trashedByAdminId              String?                      @db.Uuid
  trashReason                   String?
  restoredAt                    DateTime?
  restoredByAdminId             String?                      @db.Uuid
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  applicant                     User?                        @relation("TaxiApplicant", fields: [applicantUserId], references: [id])
  reviewedByAdmin               User?                        @relation("TaxiReviewedBy", fields: [reviewedByAdminId], references: [id])
  driverProfile                 TaxiDriverProfile?
  captainDocuments              CaptainApplicationDocument[] @relation("RideCaptainApplicationDocuments")

  @@index([status, createdAt])
  @@index([status, trashedAt, createdAt])
  @@index([phoneNumber])
  @@index([city, state])
  @@map("taxi_driver_applications")
}

model DeliveryCaptainApplication {
  id                     String                               @id @default(uuid()) @db.Uuid
  applicationReference   String                               @unique
  applicantUserId        String?                              @db.Uuid
  fullName               String
  phoneNumber            String
  email                  String?
  city                   String
  state                  String
  residentialStateCode   String?
  residentialCityCode    String?
  operatingAreaIds       String[]                             @default([])
  primaryOperatingAreaId String?
  address                String
  preferredZone          String?
  vehicleType            DeliveryCaptainVehicleType
  vehiclePlateNumber     String?
  driverLicenceNumber    String?
  riderExperience        String?
  profilePhotoUrl        String?
  guarantorName          String
  guarantorPhone         String
  notes                  String?
  status                 DeliveryCaptainApplicationStatus     @default(SUBMITTED)
  adminNote              String?
  applicantVisibleNote   String?
  reviewedAt             DateTime?
  trashedAt              DateTime?
  trashedByAdminId       String?                              @db.Uuid
  trashReason            String?
  restoredAt             DateTime?
  restoredByAdminId      String?                              @db.Uuid
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  applicant              User?                                @relation("DeliveryCaptainApplicant", fields: [applicantUserId], references: [id])
