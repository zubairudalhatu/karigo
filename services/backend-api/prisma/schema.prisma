model DeliveryCaptainApplicationDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  applicationId      String                     @db.Uuid
  documentType       String
  documentName       String?
  documentUrl        String
  verificationStatus DocumentVerificationStatus @default(PENDING)
  adminNote          String?
  uploadedAt         DateTime                   @default(now())
  verifiedByAdminId  String?                    @db.Uuid
  verifiedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  application        DeliveryCaptainApplication @relation(fields: [applicationId], references: [id])
  verifiedByAdmin    User?                      @relation("DeliveryCaptainApplicationDocumentVerifiedBy", fields: [verifiedByAdminId], references: [id])

  @@index([applicationId, verificationStatus])
  @@map("delivery_captain_application_documents")
}

model CaptainApplicationDocument {
  id                    String                         @id @default(uuid()) @db.Uuid
  userId                String                         @db.Uuid
  deliveryApplicationId String?                        @db.Uuid
  rideApplicationId     String?                        @db.Uuid
  documentType          CaptainApplicationDocumentType
  objectKey             String                         @unique
  originalFileName      String
  mimeType              String
  sizeBytes             Int
