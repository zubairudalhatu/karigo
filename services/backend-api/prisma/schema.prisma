  title      String
  message    String
  channel    NotificationChannel @default(IN_APP)
  type       NotificationType
  entityType String?
  entityId   String?             @db.Uuid
  isRead     Boolean             @default(false)
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([channel, type, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  provider   PushProvider
  appSurface AppSurface
  deviceId   String?
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id])

  @@index([userId, isActive, updatedAt])
  @@index([provider, platform, isActive])
  @@map("device_tokens")
}

model PromoCode {
  id                    String            @id @default(uuid()) @db.Uuid
  code                  String            @unique
  title                 String
  description           String?
  discountType          PromoDiscountType
  discountValue         Decimal           @db.Decimal(12, 2)
  maxDiscountAmount     Decimal?          @db.Decimal(12, 2)
  minimumOrderAmount    Decimal           @default(0) @db.Decimal(12, 2)
  usageLimit            Int?
  usageLimitPerCustomer Int?              @default(1)
  usageCount            Int               @default(0)
  firstOrderOnly        Boolean           @default(false)
  serviceCategory       ServiceCategory?
  vendorId              String?           @db.Uuid
  createdByAdminId      String?           @db.Uuid
  startsAt              DateTime
  endsAt                DateTime
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  usages                PromoCodeUsage[]
  vendor                Vendor?           @relation(fields: [vendorId], references: [id])
  createdByAdmin        User?             @relation("PromoCreatedBy", fields: [createdByAdminId], references: [id])
  orders                Order[]

  @@index([isActive, startsAt, endsAt])
  @@index([vendorId])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id             String          @id @default(uuid()) @db.Uuid
  promoCodeId    String          @db.Uuid
  customerId     String          @db.Uuid
  orderId        String          @db.Uuid
  discountAmount Decimal         @db.Decimal(12, 2)
  usedAt         DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  promoCode      PromoCode       @relation(fields: [promoCodeId], references: [id])
  customer       CustomerProfile @relation(fields: [customerId], references: [id])
  order          Order           @relation(fields: [orderId], references: [id])

  @@unique([promoCodeId, orderId])
  @@map("promo_code_usages")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  adminUser   User     @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

model LaunchMarketConfig {
  id                          String                      @id @default(uuid()) @db.Uuid
  cityCode                    String
  cityName                    String
  serviceType                 LaunchServiceType
  launchStage                 LaunchStage                 @default(OFF)
  isEnabled                   Boolean                     @default(false)
  activeFrom                  DateTime?
  activeUntil                 DateTime?
  operatingHours              Json?
  timezone                    String                      @default("Africa/Lagos")
  allowedZoneIds              Json?
  inviteCohortId              String?                     @db.Uuid
  maxConcurrentRequests       Int?
  maxUnassignedRequests       Int?
  minimumOnlineCaptainCount   Int?
  minimumOnlinePartnerCount   Int?
  assignmentTimeoutMinutes    Int?
  captainLocationFreshMinutes Int?
  customerMessage             String?
  closedMessage               String?
  internalNote                String?
  pausedReason                String?
  emergencyClosed             Boolean                     @default(false)
  updatedByAdminId            String?                     @db.Uuid
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  inviteCohort                LaunchCohort?               @relation(fields: [inviteCohortId], references: [id])
  history                     LaunchMarketConfigHistory[]
  incidents                   LaunchIncident[]
  denials                     LaunchCapacityDenial[]

  @@unique([cityCode, serviceType])
  @@index([cityCode, launchStage, isEnabled])
  @@map("launch_market_configs")
}

model LaunchMarketConfigHistory {
  id            String             @id @default(uuid()) @db.Uuid
  configId      String             @db.Uuid
  previousStage LaunchStage
  newStage      LaunchStage
  previousValue Json
  newValue      Json
  reason        String
  adminUserId   String             @db.Uuid
  createdAt     DateTime           @default(now())
  config        LaunchMarketConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("launch_market_config_history")
}

model LaunchCohort {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  cityCode         String
  startAt          DateTime?
  endAt            DateTime?
  maximumCustomers Int
  status           LaunchCohortStatus   @default(DRAFT)
  notes            String?
  createdByAdminId String               @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  members          LaunchCohortMember[]
  marketConfigs    LaunchMarketConfig[]

  @@index([cityCode, status])
  @@map("launch_cohorts")
}

model LaunchCohortMember {
  id             String                   @id @default(uuid()) @db.Uuid
  cohortId       String                   @db.Uuid
  userId         String                   @db.Uuid
  status         LaunchCohortMemberStatus @default(INVITED)
  invitedAt      DateTime                 @default(now())
  activatedAt    DateTime?
  removedAt      DateTime?
  reason         String?
  addedByAdminId String                   @db.Uuid
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  cohort         LaunchCohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId, status])
  @@map("launch_cohort_members")
}

model LaunchReadinessItem {
  id               String                @id @default(uuid()) @db.Uuid
  cityCode         String
  category         String
  key              String
  label            String
  status           LaunchReadinessStatus @default(NOT_READY)
  note             String?
  waiverReason     String?
  waiverExpiresAt  DateTime?
  updatedByAdminId String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([cityCode, key])
  @@index([cityCode, category, status])
  @@map("launch_readiness_items")
}

model LaunchIncident {
  id                   String                 @id @default(uuid()) @db.Uuid
  reference            String                 @unique
  severity             LaunchIncidentSeverity
  cityCode             String
  serviceType          LaunchServiceType?
  marketConfigId       String?                @db.Uuid
  status               LaunchIncidentStatus   @default(OPEN)
  summary              String
  timeline             Json?
  assignedOwnerId      String?                @db.Uuid
  customerImpact       String?
  captainPartnerImpact String?
  mitigation           String?
  rootCause            String?
  resolution           String?
  followUpActions      String?
  openedByAdminId      String                 @db.Uuid
  closedAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  marketConfig         LaunchMarketConfig?    @relation(fields: [marketConfigId], references: [id])

  @@index([cityCode, status, severity])
  @@index([serviceType, status])
  @@map("launch_incidents")
}

model LaunchDrill {
  id                      String             @id @default(uuid()) @db.Uuid
  cityCode                String
  drillType               LaunchDrillType
  serviceType             LaunchServiceType?
  customerUserId          String?            @db.Uuid
  captainUserId           String?            @db.Uuid
  partnerUserId           String?            @db.Uuid
  controlledCustomerId    String?            @db.Uuid
  controlledSupplyGroupId String?            @db.Uuid
  relatedReference        String?
  incidentId              String?            @db.Uuid
  supportTicketId         String?            @db.Uuid
  criticalFailure         Boolean            @default(false)
  startedAt               DateTime?
  completedAt             DateTime?
  reopenedAt              DateTime?
  result                  LaunchDrillResult  @default(NOT_STARTED)
  failureStage            String?
  notes                   String?
  evidenceReference       String?
  responsibleAdminId      String             @db.Uuid
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  steps                   LaunchDrillStep[]
  events                  LaunchDrillEvent[]

  @@index([cityCode, drillType, result])
  @@index([cityCode, serviceType, result])
  @@map("launch_drills")
}

model ControlledSupplyGroup {
  id               String                      @id @default(uuid()) @db.Uuid
  name             String
  cityCode         String
  serviceType      LaunchServiceType
  status           ControlledSupplyGroupStatus @default(DRAFT)
  startAt          DateTime?
  endAt            DateTime?
  maximumMembers   Int
  internalNote     String?
  createdByAdminId String                      @db.Uuid
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  members          ControlledSupplyMember[]

  @@index([cityCode, serviceType, status])
  @@map("controlled_supply_groups")
}

model ControlledSupplyMember {
  id             String                     @id @default(uuid()) @db.Uuid
  groupId        String                     @db.Uuid
  memberType     ControlledSupplyMemberType
  captainUserId  String?                    @db.Uuid
  vendorId       String?                    @db.Uuid
  enabled        Boolean                    @default(false)
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  reason         String?
  addedByAdminId String                     @db.Uuid
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  group          ControlledSupplyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, enabled])
  @@index([captainUserId, enabled])
  @@index([vendorId, enabled])
  @@map("controlled_supply_members")
}

model ControlledOperationsCustomer {
  id                    String    @id @default(uuid()) @db.Uuid
  cityCode              String
  customerProfileId     String    @db.Uuid
  userId                String    @unique @db.Uuid
  label                 String
  enabled               Boolean   @default(false)
  excludedFromCampaigns Boolean   @default(true)
  internalNote          String?
  addedByAdminId        String    @db.Uuid
  activatedAt           DateTime?
  deactivatedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([cityCode, customerProfileId])
  @@index([cityCode, enabled])
  @@map("controlled_operations_customers")
}

model LaunchOperationsChecklistItem {
  id               String                    @id @default(uuid()) @db.Uuid
  cityCode         String
  serviceType      LaunchServiceType
  key              String
  label            String
  mandatory        Boolean                   @default(true)
  status           LaunchChecklistItemStatus @default(NOT_READY)
  note             String?
  waiverReason     String?
  waiverExpiresAt  DateTime?
  updatedByAdminId String?                   @db.Uuid
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([cityCode, serviceType, key])
  @@index([cityCode, serviceType, status])
  @@map("launch_operations_checklist_items")
}

model LaunchDrillStep {
  id               String                @id @default(uuid()) @db.Uuid
  drillId          String                @db.Uuid
  key              String
  label            String
  position         Int
  status           LaunchDrillStepStatus @default(PENDING)
  note             String?
  updatedByAdminId String?               @db.Uuid
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  drill            LaunchDrill           @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@unique([drillId, key])
  @@index([drillId, position])
  @@map("launch_drill_steps")
}

model LaunchDrillEvent {
  id          String      @id @default(uuid()) @db.Uuid
  drillId     String      @db.Uuid
  eventType   String
  note        String?
  adminUserId String      @db.Uuid
  metadata    Json?
  createdAt   DateTime    @default(now())
  drill       LaunchDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@index([drillId, createdAt])
  @@map("launch_drill_events")
}

model LaunchCapacityDenial {
  id             String              @id @default(uuid()) @db.Uuid
  cityCode       String
  serviceType    LaunchServiceType
  marketConfigId String?             @db.Uuid
  reasonCode     String
  occurredAt     DateTime            @default(now())
  marketConfig   LaunchMarketConfig? @relation(fields: [marketConfigId], references: [id])

  @@index([cityCode, serviceType, occurredAt])
  @@map("launch_capacity_denials")
}
