{
  "expo": {
    "name": "KariGO Partner",
    "version": "1.0.0",
    "slug": "karigo-partner",
    "scheme": "karigo-partner",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "KariGO Partner uses photo access only when you choose product images, business logo or cover images to upload.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "icon": "./assets/karigo-icon.png",
    "splash": {
      "image": "./assets/karigo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "extra": {
      "router": {},
      "apiBaseUrl": "",
      "eas": {
        "projectId": "44e595bd-739a-430f-8d4d-99e961ac2451"
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/karigo-adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.karigo.partner",
      "versionCode": 5
    },
    "owner": "zamkah",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/44e595bd-739a-430f-8d4d-99e961ac2451"
    },
    "ios": {
      "bundleIdentifier": "com.karigo.partner"
    }
  }
}
