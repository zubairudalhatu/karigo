{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "partner-staging": {
      "distribution": "internal",
      "channel": "partner-staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://karigo-8htn.onrender.com/api/v1"
      }
    },
    "partner-staging-ios-simulator": {
      "distribution": "internal",
      "channel": "partner-staging",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://karigo-8htn.onrender.com/api/v1"
      }
    },
    "partner-production": {
      "distribution": "store",
      "channel": "partner-production",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://karigo-8htn.onrender.com/api/v1"
      }
    },
    "partner-play-internal": {
      "extends": "partner-production",
      "distribution": "store",
      "channel": "partner-production",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "partner-play-internal": {
      "android": {
        "track": "internal"
      }
    }
  }
}
