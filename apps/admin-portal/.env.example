# Server-side BFF backend URL. Use the approved API URL for the selected environment.
API_BASE_URL=

# Legacy/public-compatible fallback. Prefer API_BASE_URL for BFF deployments.
NEXT_PUBLIC_API_BASE_URL=

# Exact portal origin used by CSRF origin validation.
ADMIN_PORTAL_ORIGIN=
NEXT_PUBLIC_ADMIN_PORTAL_ORIGIN=

# Optional cookie/session settings. Do not set COOKIE_SECURE=false in production.
COOKIE_SECURE=
COOKIE_SAME_SITE=
SESSION_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
